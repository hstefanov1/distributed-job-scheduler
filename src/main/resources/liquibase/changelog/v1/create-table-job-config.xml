<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="hstefanov1">
        <createTable tableName="job_config">
            <column name="id"
                    type="BIGINT"
                    autoIncrement="true"
                    remarks="Unique identifier of the job.">
                <constraints primaryKey="true" primaryKeyName="job_config_pk" nullable="false"/>
            </column>
            <column name="job_name"
                    type="VARCHAR(255)"
                    remarks="The job name represented by the JobName enum class.">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="owner_id"
                    type="VARCHAR(255)"
                    remarks="Owner identifier currently responsible for this job.">
                <constraints nullable="true"/>
            </column>
            <column name="started_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="Date and time the job officially started processing business logic, in UTC.">
                <constraints nullable="true"/>
            </column>
            <column name="batch_size"
                    type="INT"
                    defaultValueNumeric="100"
                    remarks="Number of records processed per batch for this job.">
                <constraints nullable="false"/>
            </column>
            <column name="interval_seconds"
                    type="INT"
                    defaultValueNumeric="300"
                    remarks="Interval in seconds used to compute the next eligible run time after a job completes.">
                <constraints nullable="false"/>
            </column>
            <column name="enabled"
                    type="BOOLEAN"
                    defaultValueBoolean="true"
                    remarks="Enable or disable the job.">
                <constraints nullable="false"/>
            </column>
            <column name="next_run_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    defaultValueComputed="now()"
                    remarks="Date and time from which the job becomes eligible to run, in UTC.">
                <constraints nullable="false"/>
            </column>
            <column name="last_run_at"
                    type="TIMESTAMP WITH TIME ZONE"
                    remarks="Date and time the job last run, in UTC.">
                <constraints nullable="true"/>
            </column>
            <column name="last_run_status"
                    type="VARCHAR(255)"
                    defaultValue="PENDING"
                    remarks="Status of the last job run.">
                <constraints nullable="false"/>
            </column>
            <column name="last_run_exception"
                    type="VARCHAR(255)"
                    remarks="Exception message (if any) from the last job run.">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex tableName="job_config" indexName="job_config_enabled_next_run_idx">
            <column name="enabled"/>
            <column name="next_run_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
