<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="hstefanov1">
        <insert tableName="job_config">
            <column name="job_name" value="EXAMPLE_SLOW"/>
        </insert>

        <insert tableName="job_config">
            <column name="job_name" value="EXAMPLE_FAST"/>
        </insert>

        <rollback>
            <delete tableName="job_config">
                <where>job_name IN ('EXAMPLE_SLOW', 'EXAMPLE_FAST')</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>
